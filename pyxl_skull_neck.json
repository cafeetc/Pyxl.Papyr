{
  "schema": "pyxl.skull_neck.v1",
  "name": "Pyxl — Skull + Neck Assembly (Humanlike)",
  "units": {
    "pyxl_px": 10,
    "origin": "browpoint",
    "axis": { "x": "right", "y": "down" },
    "note": "All coordinates in pyxl units. 1 pyxl = 10px render. Assembly origin = browpoint (skullbone origin)."
  },
  "parts": {
    "skullbone": {
      "file": "pyxl_skullbone.json",
      "schema": "pyxl.skullbone.v1",
      "origin": { "x": 0, "y": 0 },
      "keystones": {
        "crownpoint": { "x": 0, "y": -14 },
        "browpoint": { "x": 0, "y": 0 },
        "leftpoint": { "x": -12.5, "y": 0 },
        "rightpoint": { "x": 12.5, "y": 0 },
        "nasalpoint": { "x": 0, "y": 14 },
        "chinpoint": { "x": 0, "y": 19 }
      }
    },
    "neckbone": {
      "file": "pyxl_neckbone.json",
      "schema": "pyxl.neckbone.v1",
      "origin": { "x": 0, "y": 14, "note": "neckbone origin (spinalpoint) = skullbone nasalpoint" },
      "keystones": {
        "spinalpoint": { "x": 0, "y": 14 },
        "adampoint": { "x": 0, "y": 26 },
        "vpoint": { "x": 0, "y": 33 }
      }
    }
  },
  "keystones": {
    "crownpoint": { "x": 0, "y": -14, "part": "skullbone" },
    "browpoint": { "x": 0, "y": 0, "part": "skullbone" },
    "leftpoint": { "x": -12.5, "y": 0, "part": "skullbone" },
    "rightpoint": { "x": 12.5, "y": 0, "part": "skullbone" },
    "nasalpoint": { "x": 0, "y": 14, "part": "skullbone", "aliases": ["spinalpoint"], "note": "Skull↔neck attachment. nasalpoint = spinalpoint." },
    "spinalpoint": { "x": 0, "y": 14, "part": "neckbone", "aliases": ["nasalpoint"] },
    "chinpoint": { "x": 0, "y": 19, "part": "skullbone" },
    "adampoint": { "x": 0, "y": 26, "part": "neckbone" },
    "vpoint": { "x": 0, "y": 33, "part": "neckbone" }
  },
  "keybone": {
    "segments": [
      { "a": "crownpoint", "b": "browpoint", "part": "skullbone" },
      { "a": "browpoint", "b": "nasalpoint", "part": "skullbone" },
      { "a": "nasalpoint", "b": "chinpoint", "part": "skullbone" },
      { "a": "leftpoint", "b": "browpoint", "part": "skullbone" },
      { "a": "browpoint", "b": "rightpoint", "part": "skullbone" },
      { "a": "spinalpoint", "b": "adampoint", "part": "neckbone" },
      { "a": "adampoint", "b": "vpoint", "part": "neckbone" }
    ],
    "lengths_pyxl": {
      "crown_brow": 14,
      "brow_nasal": 14,
      "nasal_chin": 5,
      "left_brow": 12.5,
      "right_brow": 12.5,
      "spinal_adam": 12,
      "adam_v": 7,
      "spinal_v": 19
    }
  },
  "attachments": [
    { "a_part": "skullbone", "a_keystone": "nasalpoint", "b_part": "neckbone", "b_keystone": "spinalpoint", "coincident": true }
  ],
  "pivots": {
    "chinpoint": { "x": 0, "y": 19, "part": "skullbone" },
    "nasalpoint": { "x": 0, "y": 14, "part": "skullbone", "aliases": ["spinalpoint"] }
  },
  "rotation_modes": {
    "rigid": { "description": "Neckpiece (down to V) is single rigid structure, rotates at vpoint. No rotation above.", "pivot_part": "neckbone", "pivot": "vpoint" },
    "lotte": { "pivot": "chinpoint", "pivot_part": "skullbone", "description": "Chin is rotation point. Everything above rotates as one." },
    "realistic": { "pivot": "nasalpoint", "pivot_part": "skullbone", "description": "Head rotates at nasalpoint / spinalpoint. 3D / simulated-perspective range." }
  },
  "hierarchy": {
    "parents": ["nasalpoint", "chinpoint"],
    "rotation_root": "active_pivot",
    "note": "nasalpoint/spinalpoint or chinpoint is primary parent depending on rotation mode. crown/left/right are proportional anchors."
  },
  "meta": {
    "version": 1,
    "date": "2026-08-26",
    "status": "blueprint",
    "variant": "humanlike",
    "parts": ["skullbone", "neckbone"],
    "skullbone_file": "pyxl_skullbone.json",
    "neckbone_file": "pyxl_neckbone.json"
  }
}
