    "note": "All coordinates in pyxl units. 1 pyxl = 10px render."
  },
  "keystones": {
    "crownpoint": {
      "x": 0,
      "y": -14
    },
    "browpoint": {
      "x": 0,
      "y": 0
    },
    "leftpoint": {
      "x": -12.5,
      "y": 0
    },
    "rightpoint": {
      "x": 12.5,
      "y": 0
    },
    "nasalpoint": {
      "x": 0,
      "y": 14,
      "note": "Skull's lowest point. Below nose, above upper lip / teeth start. Spinalpoint attaches here. Rotation source when chinpoint is not active."
    },
    "chinpoint": {
      "x": 0,
      "y": 19
    },
    "left_jawpoint": {
      "x": -7.2,
      "y": 7,
      "note": "Left masseter / jaw corner. Formerly 'left_cheek_bone' in canvas prototype. Canvas-accurate."
    },
    "right_jawpoint": {
      "x": 7.2,
      "y": 7,
      "note": "Right masseter / jaw corner. Formerly 'right_cheek_bone' in canvas prototype. Canvas-accurate."
    },
    "left_cheekpoint": {
      "x": -9.5,
      "y": 4,
      "note": "Left zygomatic cheek bone. Independent rotation pivot. Ball at end of cone."
    },
    "right_cheekpoint": {
      "x": 9.5,
      "y": 4,
      "note": "Right zygomatic cheek bone. Independent rotation pivot. Ball at end of cone."
    }
  },
  "keybone": {
    "segments": [
      {
        "a": "crownpoint",
        "b": "browpoint"
      },
      {
        "a": "browpoint",
        "b": "nasalpoint"
      },
      {
        "a": "nasalpoint",
        "b": "chinpoint"
      },
      {
        "a": "leftpoint",
        "b": "browpoint"
      },
      {
        "a": "browpoint",
        "b": "rightpoint"
      },
      {
        "a": "leftpoint",
        "b": "left_cheekpoint",
        "note": "Cheek cone \u2014 zygomatic strut"
      },
      {
        "a": "left_cheekpoint",
        "b": "left_jawpoint",
        "note": "Cheek-to-jaw"
      },
      {
        "a": "rightpoint",
        "b": "right_cheekpoint",
        "note": "Cheek cone \u2014 zygomatic strut"
      },
      {
        "a": "right_cheekpoint",
        "b": "right_jawpoint",
        "note": "Cheek-to-jaw"
      }
    ],
    "lengths_pyxl": {
      "crown_brow": 14,
      "brow_nasal": 14,
      "nasal_chin": 5,
      "left_brow": 12.5,
      "right_brow": 12.5,
      "left_cheek_cone": 4.92,
      "left_cheek_jaw": 3.81,
      "right_cheek_cone": 4.92,
      "right_cheek_jaw": 3.81
